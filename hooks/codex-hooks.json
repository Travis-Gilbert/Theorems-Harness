{
  "description": "Theorems Harness hooks for Codex. Generated by theorem-harness-package from mapping v1; do not edit.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" codex",
            "statusMessage": "Recording the Theorems Harness tool outcome",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|exec_command|functions.exec_command|apply_patch|functions.apply_patch|Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" codex",
            "statusMessage": "Checking Theorems Harness capability triggers",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|exec_command|functions.exec_command|apply_patch|functions.apply_patch|Edit|Write"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"${PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" codex",
            "statusMessage": "Opening the Theorems Harness session run",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"${PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" codex",
            "statusMessage": "Recording the Theorems Harness turn",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"${PLUGIN_ROOT}/hooks/wiring-review-stop.sh\"",
            "statusMessage": "Reviewing wiring for new orphans",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node \"${PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" codex",
            "statusMessage": "Preparing the Theorems Harness capability packet",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
