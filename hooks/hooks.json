{
  "description": "Theorems Harness hooks for Claude Code. Generated by theorem-harness-package from mapping v1; do not edit.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" claude_code",
            "shell": "bash",
            "statusMessage": "Recording the Theorems Harness tool outcome",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write|NotebookEdit"
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" claude_code",
            "shell": "bash",
            "statusMessage": "Recording the Theorems Harness tool outcome",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write|NotebookEdit"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" claude_code",
            "shell": "bash",
            "statusMessage": "Checking Theorems Harness capability triggers",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "Bash|Edit|Write|NotebookEdit"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" claude_code",
            "shell": "bash",
            "statusMessage": "Closing the Theorems Harness session run",
            "timeout": 25,
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" claude_code",
            "shell": "bash",
            "statusMessage": "Opening the Theorems Harness session run",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" claude_code",
            "shell": "bash",
            "statusMessage": "Recording the Theorems Harness turn",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/wiring-review-stop.sh\"",
            "shell": "bash",
            "statusMessage": "Reviewing wiring for new orphans",
            "timeout": 60,
            "type": "command"
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" claude_code",
            "shell": "bash",
            "statusMessage": "Recording the Theorems Harness turn",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/src/bin/theorem-hook.mjs\" claude_code",
            "shell": "bash",
            "statusMessage": "Preparing the Theorems Harness capability packet",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
